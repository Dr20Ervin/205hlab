# ------------------------------
# Core Settings
# ------------------------------
TZ=UTC
# Primary server Management VLAN (MNGT_VLAN) IPv4 address reachable by Home Assistant (HAOS)
MNGT_IP=

# ------------------------------
# Wyoming Whisper (STT) Settings
# ------------------------------
WYOMING_WHISPER_PORT=10300
# Swap to tiny-int8 if lower transcription latency is preferred
WHISPER_MODEL=base-int8
WHISPER_LANGUAGE=en
WHISPER_BEAM_SIZE=1

# ------------------------------
# Wyoming Piper (TTS) Settings
# ------------------------------
WYOMING_PIPER_PORT=10200
# Host directory holding custom Piper voice files (jarvis-medium.onnx & .onnx.json)
PIPER_DATA_DIR=/srv/wyoming/piper
PIPER_VOICE=jarvis-medium
PIPER_LENGTH_SCALE=1.08

# ------------------------------
# Wyoming openWakeWord Settings
# ------------------------------
WYOMING_OPENWAKEWORD_PORT=10400
OPENWAKEWORD_PRELOAD_MODEL=hey_jarvis
