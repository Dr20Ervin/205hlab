# ------------------------------
# Core Settings
# ------------------------------
FQDN=205hlab.com
PUID=1000
PGID=1000
TZ=UTC

# ------------------------------
# Network & Storage Settings
# ------------------------------
MNGT_IP=192.168.1.10
DOWNLOADS_DIR=/mnt/storage/downloads

# ------------------------------
# Gluetun & AirVPN Settings
# ------------------------------
AIRVPN_SERVICE_PROVIDER=airvpn
AIRVPN_WIREGUARD_PRIVATE_KEY=
AIRVPN_WIREGUARD_PRESHARED_KEY=
AIRVPN_WIREGUARD_ADDRESSES=
AIRVPN_SERVER_COUNTRIES=Romania
TORRENTING_PORT=

# ------------------------------
# qBittorrent Settings
# ------------------------------
QBITTORRENT_WEBUI_PORT=8080

# ------------------------------
# Qui & PostgreSQL Settings
# ------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
QUI_DATABASE_USER=qui_app
QUI_DATABASE_NAME=qui
QUI_DATABASE_PASSWORD=
QUI_SESSION_SECRET=
QUI_METRICS_ENABLED=true
QUI_METRICS_PORT=9074

# ------------------------------
# Qui Authentik OIDC Settings
# ------------------------------
QUI_OIDC_ENABLED=true
QUI_OIDC_CLIENT_ID=
QUI_OIDC_CLIENT_SECRET=
QUI_OIDC_DISABLE_BUILT_IN_LOGIN=true
