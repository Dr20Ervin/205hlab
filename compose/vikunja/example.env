# ------------------------------
# Core Settings
# ------------------------------
FQDN=205hlab.com
TZ=UTC
VIKUNJA_CONFIG_DIR=
VIKUNJA_TRUSTED_PROXIES=

# ------------------------------
# PostgreSQL Database Settings
# ------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=vikunja_app
POSTGRES_DB=vikunja
POSTGRES_PASSWORD=

# ------------------------------
# Security & Auth Settings
# ------------------------------
VIKUNJA_SERVICE_SECRET=
VIKUNJA_ENABLE_REGISTRATION=false
VIKUNJA_AUTH_LOCAL_ENABLED=false

# ------------------------------
# Authentik OIDC Settings
# ------------------------------
VIKUNJA_OIDC_ENABLED=true
VIKUNJA_OIDC_NAME="authentik Login"
VIKUNJA_OIDC_CLIENT_ID=
VIKUNJA_OIDC_CLIENT_SECRET=
# OIDC Scopes: "openid profile email" (add "groups" for standard OIDC team sync in v2.8+, or use Authentik property mapping "vikunja_scope")
VIKUNJA_OIDC_SCOPE="openid profile email"

# ------------------------------
# SMTP Email Settings
# ------------------------------
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
