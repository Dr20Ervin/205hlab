# ------------------------------
# Core Settings
# ------------------------------
FQDN=205hlab.com

# ------------------------------
# PostgreSQL Database Settings
# ------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=reactive-resume_app
POSTGRES_DB=reactive-resume
POSTGRES_PASSWORD=

# ------------------------------
# Security & Auth Secrets
# ------------------------------
# Generate with: openssl rand -hex 32 (or run ./setup_secrets.sh)
AUTH_SECRET=

# ------------------------------
# Authentik OIDC Settings
# ------------------------------
AUTHENTIK_SLUG=reactive-resume
OAUTH_PROVIDER_NAME=Authentik
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_SCOPES=openid profile email

# ------------------------------
# Feature Flags
# ------------------------------
FLAG_DISABLE_SIGNUPS=true
FLAG_DISABLE_EMAIL_AUTH=false
FLAG_ENABLE_GUEST_LOGIN=false

# ------------------------------
# Reverse Proxy Trust
# ------------------------------
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# ------------------------------
# SMTP Email Settings
# ------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=true

# ------------------------------
# AI & Assistant Settings (Optional)
# ------------------------------
# Generate with: openssl rand -hex 32 (required if storing user API keys)
# ENCRYPTION_SECRET=
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=
# AI_BASE_URL=
