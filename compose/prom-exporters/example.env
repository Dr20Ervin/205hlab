# ------------------------------
# Technitium Exporter Settings
# ------------------------------
TECHNITIUM_TOKEN=

# ------------------------------
# PostgreSQL Exporter Settings
# ------------------------------
POSTGRES_HOST=205hlab-pgdb
POSTGRES_PORT=5432
POSTGRES_EXPORTER_USER=postgres_exporter
POSTGRES_EXPORTER_PASSWORD=

# ------------------------------
# Cloudflare Exporter Settings
# ------------------------------
# Account-Scoped API Token Authentication (Required)
CF_API_TOKEN=
CF_ACCOUNTS=

# Optional: Zone filtering (leave commented to export all accessible zones in the account)
# CF_ZONES=
# CF_EXCLUDE_ZONES=

# Optional: Advanced settings (leave commented to use production defaults)
# CF_FREE_TIER=false
# CF_SCRAPE_INTERVAL=60
# CF_SCRAPE_DELAY=300
# CF_ENABLE_EDGE_ERRORS_BY_PATH=false
# CF_ENABLE_ACCOUNT_USAGE_METRICS=false
