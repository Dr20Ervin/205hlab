# ------------------------------
# Core Settings
# ------------------------------
FQDN=205hlab.com
TZ=UTC

# ------------------------------
# PostgreSQL 18 Database Settings
# ------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=umami_app
POSTGRES_DB=umami
POSTGRES_PASSWORD=

# ------------------------------
# Umami Security & Telemetry Settings
# ------------------------------
# Generate with: openssl rand -hex 32 (or run setup_secrets.sh)
UMAMI_APP_SECRET=
# Tracker script filename (no leading slash) — exposed at https://analytics.${FQDN}/pulse.js
UMAMI_TRACKER_SCRIPT_NAME=pulse.js
# Collection API path (must include leading slash) — exposed at https://analytics.${FQDN}/api/collect
UMAMI_COLLECT_API_ENDPOINT=/api/collect
# Comma-separated CIDRs excluded from analytics (loopback only so LAN, VPN, and Docker bridge visits are tracked)
UMAMI_IGNORE_IP=127.0.0.1
