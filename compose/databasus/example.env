# ------------------------------
# Core Settings
# ------------------------------
FQDN=205hlab.com
TZ=UTC

# ------------------------------
# Databasus Backup Storage (ZFS BinPool dataset)
# ------------------------------
DATABASUS_BACKUP=/BinPool/backups/postgres

# ------------------------------
# Databasus Restore Verification Agent
# (Generated in Databasus UI -> Settings -> Verification agents)
# ------------------------------
DATABASUS_AGENT_ID=
DATABASUS_AGENT_TOKEN=
DATABASUS_MAX_CPU=2
DATABASUS_MAX_RAM_MB=2048
DATABASUS_MAX_DISK_GB=25
DATABASUS_MAX_CONCURRENT_JOBS=1
