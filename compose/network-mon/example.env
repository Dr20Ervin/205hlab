# ------------------------------
# Core Settings
# ------------------------------
FQDN=205hlab.com
TZ=UTC
LAN_IP=192.168.1.10
MNGT_IP=192.168.10.10
PUID=1000
PGID=1000

# ------------------------------
# OpenSpeedTest Settings
# ------------------------------
OPENSPEEDTEST_PORT=3000
OPENSPEEDTEST_MNGT_PORT=3000
APP_DEBUG=false

# ------------------------------
# MyIP Settings
# ------------------------------
MYIP_PORT=18966
# Comma-separated domains allowed to query the MyIP backend API
MYIP_ALLOWED_DOMAINS=myip.internal.205hlab.com

# ------------------------------
# Speedtest Tracker Settings
# ------------------------------
APP_KEY=
APP_DEBUG=false
SPEEDTEST_SCHEDULE=0 1,4,7,11 * * *
# Comma-separated server IDs to test against (leave empty for auto):
SPEEDTEST_SERVERS=
PRUNE_RESULTS_OLDER_THAN=90

# ------------------------------
# PostgreSQL Database Settings
# ------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=speedtest_tracker
POSTGRES_USER=speedtest_app
POSTGRES_PASSWORD=
